<#
.SYNOPSIS
CSA Validation Pack for OMS / ODA Assessments Module

.DESCRIPTION
Validates module presence, paths, AMA/MMA health, and readiness for Add-*AssessmentTask execution.

.NOTES
Author: CSA-ready
Safe for audit use
#>

# =========================
# GLOBAL SETTINGS
# =========================
$ErrorActionPreference = "SilentlyContinue"
$Report = @()
$Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

function Add-Result {
    param($Check, $Status, $Details)
    $Report += [PSCustomObject]@{
        Time    = $Timestamp
        Check   = $Check
        Status  = $Status
        Details = $Details
    }
}

Write-Host "===== ODA / OMS Assessment Validation =====" -ForegroundColor Cyan

# =========================
# 1. CHECK POWERSHELL VERSION
# =========================
$ps = $PSVersionTable
if ($ps.CLRVersion.Major -ge 4) {
    Add-Result "PowerShell CLR Version" "OK" "$($ps.CLRVersion)"
} else {
    Add-Result "PowerShell CLR Version" "FAIL" "CLR version < 4.0"
}

# =========================
# 2. CHECK AGENT (AMA / MMA)
# =========================
$service = Get-Service -Name "HealthService" -ErrorAction SilentlyContinue

if ($service -and $service.Status -eq "Running") {
    Add-Result "MMA/HealthService" "OK" "Running"
} else {
    Add-Result "MMA/HealthService" "FAIL" "Service missing or not running"
}

# =========================
# 3. CHECK MODULE PATH VARIABLE
# =========================
$modulePath = $env:PSModulePath

if ($modulePath -match "Oms.Assessments") {
    Add-Result "PSModulePath" "OK" "Contains OMS module path"
} else {
    Add-Result "PSModulePath" "WARNING" "Missing OMS module path"
}

# =========================
# 4. CHECK STANDARD LOCATIONS
# =========================
$paths = @(
    "C:\ODA\Binaries\bin\Microsoft.PowerShell.Oms.Assessments",
    "C:\Program Files\Microsoft Monitoring Agent\Agent\PowerShell\Microsoft.PowerShell.Oms.Assessments",
    "C:\Packages\Plugins\Microsoft.ServicesHub.AssessmentPlatform"
)

foreach ($path in $paths) {
    if (Test-Path $path) {
        Add-Result "Path Check" "OK" "$path exists"
    } else {
        Add-Result "Path Check" "INFO" "$path not found"
    }
}

# =========================
# 5. CHECK DLL PRESENCE
# =========================
$dllPaths = Get-ChildItem -Path "C:" -Recurse -Filter "Microsoft.PowerShell.Oms.Assessments.dll" -ErrorAction SilentlyContinue -Depth 4

if ($dllPaths) {
    foreach ($dll in $dllPaths) {
        Add-Result "DLL Found" "OK" $dll.FullName
    }
} else {
    Add-Result "DLL Found" "FAIL" "Microsoft.PowerShell.Oms.Assessments.dll not found"
}

# =========================
# 6. CHECK MODULE AVAILABILITY
# =========================
$module = Get-Module -ListAvailable -Name Microsoft.PowerShell.Oms.Assessments

if ($module) {
    Add-Result "Module Availability" "OK" "Module registered in PS"
} else {
    Add-Result "Module Availability" "FAIL" "Module not discoverable"
}

# =========================
# 7. TEST IMPORT MODULE
# =========================
try {
    Import-Module Microsoft.PowerShell.Oms.Assessments -ErrorAction Stop
    Add-Result "Import Module" "OK" "Module imported successfully"
}
catch {
    Add-Result "Import Module" "FAIL" $_.Exception.Message
}

# =========================
# 8. VALIDATE AMA DELIVERY (INDIRECT)
# =========================
$odaPath = "C:\ODA\Binaries\bin"
if (Test-Path $odaPath) {
    Add-Result "ODA Binaries Folder" "OK" "Folder exists"
} else {
    Add-Result "ODA Binaries Folder" "FAIL" "Missing - AMA likely not synced"
}

# =========================
# 9. FINAL STATUS
# =========================
